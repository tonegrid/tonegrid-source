# Supplied assets are never regenerated by juceaide.
set(tonegrid_icons "${CMAKE_CURRENT_SOURCE_DIR}/Resources/AppIcons")
if(WIN32)
    file(TO_CMAKE_PATH "${tonegrid_icons}/Windows/ToneGrid.ico" tonegrid_ico)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ToneGridIcon.rc" "IDI_ICON1 ICON DISCARDABLE \"${tonegrid_ico}\"\nIDI_ICON2 ICON DISCARDABLE \"${tonegrid_ico}\"\n")
    target_sources(ToneGrid PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/ToneGridIcon.rc")
elseif(APPLE)
    target_sources(ToneGrid PRIVATE "${tonegrid_icons}/ToneGrid.icns")
    set_source_files_properties("${tonegrid_icons}/ToneGrid.icns" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    set_target_properties(ToneGrid PROPERTIES MACOSX_BUNDLE_ICON_FILE ToneGrid.icns)
elseif(UNIX)
    install(FILES "${tonegrid_icons}/ToneGrid.svg" DESTINATION share/icons/hicolor/scalable/apps RENAME tonegrid.svg)
    foreach(size 16 24 32 48 64 128 256 512)
        install(FILES "${tonegrid_icons}/ToneGrid-${size}.png" DESTINATION "share/icons/hicolor/${size}x${size}/apps" RENAME tonegrid.png)
    endforeach()
endif()
